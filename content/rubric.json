{
  "note": "每层任务的参考判据。三条可观察项，命中 2 条算过。keywords 只给规则兜底用，模型判分时读 item 文本。判据必须是能指出来「有没有」的动作，不能是「体现出批判性思维」这类没法证明的标准。注意：这条判据现在只用于卡片页底部的「想让 AI 看一眼」参考建议，不参与解锁——解锁只看用户自己打勾的三条自检。",
  "levels": [
    {
      "level": 1,
      "title": "先开口",
      "task": "把明天要交的作业题目拍照发进去，问「这题考什么知识点，给我三个提示，不要给答案」。",
      "passNeed": 2,
      "rubric": [
        {
          "key": "asked",
          "item": "说清楚自己问的是哪道题、哪门课",
          "keywords": ["题", "作业", "课", "科目", "知识点"]
        },
        {
          "key": "replied",
          "item": "贴出了 AI 回答的内容（原话或大意都算）",
          "keywords": ["它说", "回答", "回复", "提示", "答案", "说：", "说:"]
        },
        {
          "key": "hintNotAnswer",
          "item": "回答里看出给的是提示，不是直接把答案抄下来",
          "keywords": ["提示", "思路", "步骤", "方向", "不要给答案", "先想"]
        }
      ]
    },
    {
      "level": 2,
      "title": "喂料",
      "task": "把本学期课表截图发进去，问「按这份课表，我这周哪天最累，为什么」。",
      "passNeed": 2,
      "rubric": [
        {
          "key": "uploaded",
          "item": "说了传进去的是哪个文件（课表、PPT、PDF 都算）",
          "keywords": ["课表", "截图", "传了", "上传", "PDF", "文件", "附件"]
        },
        {
          "key": "specific",
          "item": "复述出它从文件里读到的具体内容（哪天、几节、什么课）",
          "keywords": ["周", "节", "课", "早八", "晚课", "上到"]
        },
        {
          "key": "checked",
          "item": "核对过它有没有读错，或说出它哪里读漏了",
          "keywords": ["读错", "漏", "对不上", "重传", "核对", "验证", "它没看到"]
        }
      ]
    },
    {
      "level": 3,
      "title": "接工具",
      "task": "装一个「文件系统」MCP，让它列出你 D 盘某个文件夹里有什么，再让它把其中一个文件重命名。",
      "passNeed": 2,
      "rubric": [
        {
          "key": "installed",
          "item": "说了装的是什么（Cherry Studio / Cursor / Claude Desktop + MCP 名称）",
          "keywords": ["Cherry", "Cursor", "Claude", "MCP", "装", "安装", "配置"]
        },
        {
          "key": "action",
          "item": "说了让它做的具体动作（列目录、重命名）",
          "keywords": ["列出", "列", "重命名", "改名", "文件夹", "目录", "D 盘", "D盘"]
        },
        {
          "key": "evidence",
          "item": "有结果证据：贴出了文件名，或说清改名前后叫什么",
          "keywords": ["改成", "原名", "现在叫", "看到", "列出来", "结果", "里面有", "报错"]
        }
      ]
    },
    {
      "level": 4,
      "title": "编排",
      "task": "n8n 里搭一条流：每天 8 点读课表、抓天气，拼成一句话发给你。",
      "passNeed": 2,
      "rubric": [
        {
          "key": "tool",
          "item": "说了用的是什么工具（n8n / Dify / Coze）",
          "keywords": ["n8n", "Dify", "Coze", "扣子", "工作流", "节点"]
        },
        {
          "key": "steps",
          "item": "说了这条流有哪几步（定时、读课表、抓天气、发消息）",
          "keywords": ["定时", "每天", "8 点", "8点", "触发", "天气", "课表", "发送", "消息", "节点"]
        },
        {
          "key": "ran",
          "item": "说了实际跑出来的结果或报错原文",
          "keywords": ["跑通", "跑了", "执行", "收到", "报错", "失败", "日志", "输出"]
        }
      ]
    }
  ]
}
